# .mcpbignore - pack exclusions (read from pack root mcpb/ by `mcpb pack`)
# Synced to mcpb/.mcpbignore by scripts/mcpb-pack.ps1 before each pack.
.venv/
node_modules/
**/node_modules/
webapp/
src-tauri/
native/
tests/
data/
target/
dist/
build/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.git/
.env
.coverage
*.bak
*.bak.*
playwright-report/
test-results/
glama.json
llms.txt
llms-full.txt
.github/
.vscode/
*.mcpb
mcpb/pyproject.toml.bak*
