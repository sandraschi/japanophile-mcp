# Copy to .env - all optional for stage 1 (no keys needed, seeds are local).
JPN_MCP_BACKEND_PORT=11193
JPN_MCP_DATA_DIR=data

# Fleet crossconnects (crossconnect tool + /api/crossconnect/*) - only needed if
# a peer runs on a non-default port or host. Unreachable peers degrade gracefully.
SPEECH_MCP_URL=http://127.0.0.1:10909
CALIBRE_MCP_URL=http://127.0.0.1:10720
PLEX_MCP_URL=http://127.0.0.1:10740
