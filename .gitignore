# japanophile-mcp .gitignore - created BEFORE first git add (gate rule)
# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Writable / local only
data/progress.db
data/progress.db-*

# Vendored corpora (committed): kanji.db, wakan_vocab.json — see data/README.md
# Ignore other accidental drops under data/
data/*.zip
data/edict2.gz

# Node / webapp (stage 2)
node_modules/
**/node_modules/
webapp/dist/

# Tauri (stage 2)
target/
**/target/
src-tauri/binaries/

# MCPB pack staging
mcpb/src/
*.mcpb

# Sneak-in specialist backups
*.bak
*.bak.*

# Env and coverage
.env
.coverage
htmlcov/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
